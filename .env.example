# Copy to .env.local for local development. Every value here is the default
# that src/lib/api.ts falls back to, so an empty file works against a backend
# running on localhost:8000.
#
# Vite inlines these at build time, not at runtime: they are baked into the
# bundle and visible to anyone who loads the page. Never put a secret here.
# Only names starting with VITE_ are exposed to the app.

# Where the REST API lives. Absolute in development because Django runs on a
# different port; behind a reverse proxy in production this is usually the
# relative "/api/v1" instead, which keeps cookies same-origin.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Where the WebSocket lives. Defaults to VITE_API_BASE_URL, whose scheme is
# swapped to ws:// or wss://, so set this only when the socket is served from
# somewhere other than the API.
# VITE_WS_BASE_URL=http://localhost:8000
